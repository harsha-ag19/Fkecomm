FROM jfrog.fkinternal.com/jarvis-services/megatron-bridge:v0-test
USER root

# 1. Install Megatron-LM with --no-deps to prevent transitive dependency upgrades
RUN pip uninstall -y megatron-core && \
    pip install --no-cache-dir \
      pybind11 && \
    cd /workspace/megatron-bridge/3rdparty/Megatron-LM && \
    pip install --no-cache-dir --no-build-isolation --no-deps \
      -e .

# 2. Install Ray
RUN pip install --no-cache-dir \
      "ray[default,train]==2.56.1"

RUN ray --version && test -x "$(command -v ray)"

# 3. Install custom-built NVIDIA Resiliency Extension (--no-deps)
RUN pip install --no-cache-dir --no-deps \
      "nvidia-resiliency-ext==0.6.0"

# 4. Uninstall CUTLASS 4.6.0+ libraries and pin nvidia-cutlass-dsl < 4.6.0 (installs 4.5.3)
RUN pip uninstall -y nvidia-cutlass-dsl nvidia-cutlass-dsl-libs-base nvidia-cutlass-dsl-libs-cu12 nvidia-cutlass-dsl-libs-cu13 nvidia-cutlass-dsl-libs-core && \
    pip install --no-cache-dir \
      "nvidia-cutlass-dsl<4.6.0"

# 5. Verification step
RUN python -c "import nvidia_resiliency_ext as nvrx; print('NVRX OK version:', nvrx.__version__)" && \
    python -c "import megatron.core; print('megatron.core from:', megatron.core.__file__)" && \
    python -c "from megatron.core._rank_utils import safe_get_rank; print('_rank_utils OK')" && \
    python -c "import torch, transformer_engine, flash_attn, mamba_ssm; print('extensions OK')" && \
    python -c "import megatron.core, megatron.bridge; print('core + bridge OK')"

RUN chown -R app:app /workspace

WORKDIR /workspace/megatron-bridge
USER app